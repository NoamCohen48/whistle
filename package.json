{
  "name": "whistle-poc",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "package": "bun run build && bun run scripts/package.ts",
    "test:package": "bun run package && bun test ./tests/packaging.check.ts",
    "dev": "vite",
    "start": "bun run build && bun run src/server.ts",
    "test": "bun test",
    "test:e2e": "bun run build && playwright test",
    "test:vm:unit": "python3 -m unittest discover -s vm_tests/tests -t . -v",
    "test:vm": "python3 -m vm_tests.run",
    "typecheck": "tsc --noEmit",
    "pair": "bun run src/pair.ts",
    "whistle": "bun run src/cli.ts"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "ws": "^8.22.0"
  }
}
