{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["bun", "vite/client"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx"
  },
  "include": ["src/**/*.ts", "web/**/*.ts", "web/**/*.tsx", "tests/**/*.ts", "scripts/**/*.ts", "site/**/*.ts", "vite.config.ts", "playwright.config.ts"]
}
